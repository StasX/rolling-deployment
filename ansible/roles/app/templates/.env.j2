APP_NAME="{{ project_name }}"
APP_URL="{{ app_url }}"
APP_RUNTIME_ENV_FILE="{{ app_runtime_env_file }}"

DB_HOST="{{ db_host }}"
DB_PORT={{ db_port | default(3306) }}
DB_DATABASE="{{ db_database }}"
DB_USERNAME="{{ db_username }}"
DB_PASSWORD={{ db_password | replace('$', '$$') | to_json(ensure_ascii=false) }}

REDIS_SENTINEL_HOSTS={{ redis_sentinel_ips | join(',') }}
REDIS_SENTINEL_PORT={{ redis_sentinel_port }}
REDIS_SENTINEL_MASTER={{ redis_sentinel_master_name }}
REDIS_SENTINEL_PASSWORD={{ redis_sentinel_password | replace('$', '$$') | to_json(ensure_ascii=false) }}
REDIS_PASSWORD={{ redis_password | replace('$', '$$') | to_json(ensure_ascii=false) }}

AWS_DEFAULT_REGION="{{ aws_region }}"
AWS_BUCKET="{{ aws_uploads_bucket }}"
AWS_USE_PATH_STYLE_ENDPOINT=false
